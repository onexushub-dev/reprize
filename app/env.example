REPRIZE_RC_TEST_KEY=
REPRIZE_BUNDLE_ID=
REPRIZE_POSTHOG_KEY=
# 1 shows the in-app Diagnóstico screen and keeps its log (local test builds only; never in EAS production)
REPRIZE_DIAGNOSTICS=
REPRIZE_SUPABASE_URL=
REPRIZE_SUPABASE_KEY=
# Sharing spike 1 (/spike-upload), diagnostics builds only: same value as the SPIKE_KEY secret of spike-sign
REPRIZE_SPIKE_KEY=
# Google sign-in: the iOS OAuth client of the bundle id being built, and the Web client set in Supabase
REPRIZE_GOOGLE_IOS_CLIENT_ID=
REPRIZE_GOOGLE_WEB_CLIENT_ID=
